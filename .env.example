# LLM provider: use "groq" for the API or "ollama" for your local model.
LLM_PROVIDER=groq

# Groq API (create a key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama fallback (set LLM_PROVIDER=ollama to use these settings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192

# Embeddings / chunking / retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_CONTEXT_CHARS=9000
REFLECTION_ENABLED=true
